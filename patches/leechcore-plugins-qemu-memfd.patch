+// Find QEMU's guest RAM fd in /proc/<pid>/fd: a hugetlbfs file or a memfd
+// created by memory-backend-memfd. If several match, take the largest one.
+static BOOL DeviceQEMU_IsRamFdTarget(_In_ LPCSTR szTarget)
+{
+    return !strncmp(szTarget, HUGEPAGES_PATH, sizeof(HUGEPAGES_PATH) - 1) ||
+           !strncmp(szTarget, "/memfd:memory-backend-memfd", 27);
+}
