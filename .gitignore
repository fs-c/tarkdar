/build*/
/dumps/
*.raw
*.dmp
compile_commands.json
.cache/
__pycache__/
node_modules/
/web/dist/
*.jsonl
/recordings/

# Large data files live in the asset store, listed in assets.json (tools/assets.py pull).
.assets.env
*.assets-tmp
.assets-staging/
.assets-hashes.json
.assets-base.json
.assets-trash/

# Maps are derived from copyrighted material, so they live in the asset store too: maps/3d (built by
# tools/maps3d).
/maps/

.claude/worktrees/

# Dotfiles are ignored by default; allow the ones that belong in the repo explicitly.
.*
!.gitignore
!.gitmodules
